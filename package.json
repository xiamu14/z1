{
  "name": "z1-monorepo",
  "private": true,
  "packageManager": "bun@1.3.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "bun --cwd apps/web run dev",
    "build:web": "bun --cwd apps/web run build",
    "lint:web": "bun --cwd apps/web run lint",
    "dev:cms": "bun --cwd apps/cms run dev",
    "build:cms": "bun --cwd apps/cms run build",
    "lint:cms": "bun --cwd apps/cms run lint",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,mjs,json,md,mdx,scss}\" --cache"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8"
  }
}
